# Copy to .env and fill in. Never commit .env.

# Supabase → Connect → Session pooler (IPv4). Replace [YOUR-PASSWORD].
# postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Key for signing the JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# AES-256-GCM key that encrypts the TOTP secrets stored in mfa_configs.
# 32 random bytes in base64. Generate one with:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If it is lost, the stored secrets can't be decrypted and users must re-enroll 2FA.
MFA_ENCRYPTION_KEY=

# Token lifetimes in seconds
PRE_AUTH_TOKEN_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900

# Name shown in Google Authenticator / our app next to the account
TOTP_ISSUER=Lab2FA

# Local Prefect server started with `prefect server start`
PREFECT_API_URL=http://127.0.0.1:4200/api
